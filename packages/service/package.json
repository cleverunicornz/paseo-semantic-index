{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@cleverunicornz/semantic-index-service",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/config.ts src/contracts.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cleverunicornz/semantic-index-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "async-mutex": "0.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "20.19.17",
    "esbuild": "0.28.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
